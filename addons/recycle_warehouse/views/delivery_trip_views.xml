<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- The order admin's delivery-stages screen: every trip, every station,
         its status and the time it was collected, and a map pin for each. -->
    <record id="view_delivery_trip_list" model="ir.ui.view">
        <field name="name">recycle.delivery.trip.list</field>
        <field name="model">recycle.delivery.trip</field>
        <field name="arch" type="xml">
            <list string="Delivery Trips" decoration-success="status == 'completed'"
                  decoration-muted="status == 'cancelled'"
                  decoration-info="status == 'in_progress'">
                <field name="trip_number"/>
                <field name="order_number"/>
                <field name="buyer_name"/>
                <field name="origin_warehouse_id"/>
                <field name="truck_id"/>
                <field name="driver_id"/>
                <field name="route_distance_km"/>
                <field name="delivery_cost"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'completed'"
                       decoration-info="status == 'in_progress'"/>
            </list>
        </field>
    </record>

    <record id="view_delivery_trip_form" model="ir.ui.view">
        <field name="name">recycle.delivery.trip.form</field>
        <field name="model">recycle.delivery.trip</field>
        <field name="arch" type="xml">
            <form string="Delivery Trip">
                <header>
                    <field name="status" widget="statusbar"
                           statusbar_visible="assigned,in_progress,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="trip_number" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="order_number" readonly="1"/>
                            <field name="buyer_name" readonly="1"/>
                            <field name="origin_warehouse_id" readonly="1"/>
                            <field name="truck_id" readonly="1"/>
                            <field name="driver_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="route_distance_km" readonly="1"/>
                            <field name="delivery_cost" readonly="1"/>
                            <field name="currency_code" readonly="1"/>
                            <field name="dest_maps_url" widget="url" readonly="1"
                                   text="Open buyer location in Google Maps"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Stations (delivery stages)">
                            <field name="stop_ids" readonly="1">
                                <list decoration-success="is_collected == True"
                                      decoration-warning="is_collected == False">
                                    <field name="sequence"/>
                                    <field name="warehouse_id"/>
                                    <field name="product_summary"/>
                                    <field name="distance_to_buyer_km"/>
                                    <field name="is_collected" widget="boolean_toggle"/>
                                    <field name="picked_up_at"/>
                                    <field name="maps_url" widget="url"
                                           text="Map" optional="show"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_delivery_trip_search" model="ir.ui.view">
        <field name="name">recycle.delivery.trip.search</field>
        <field name="model">recycle.delivery.trip</field>
        <field name="arch" type="xml">
            <search string="Delivery Trips">
                <field name="trip_number"/>
                <field name="order_number"/>
                <field name="buyer_name"/>
                <field name="driver_id"/>
                <filter name="live" string="Live"
                        domain="[('status', 'in', ['assigned', 'in_progress'])]"/>
                <filter name="completed" string="Completed"
                        domain="[('status', '=', 'completed')]"/>
                <separator/>
                <filter name="by_status" string="Status" context="{'group_by': 'status'}"/>
                <filter name="by_driver" string="Driver" context="{'group_by': 'driver_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_recycle_delivery_trip" model="ir.actions.act_window">
        <field name="name">Delivery Trips</field>
        <field name="res_model">recycle.delivery.trip</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_delivery_trip_search"/>
        <field name="context">{'search_default_live': 1}</field>
    </record>

</odoo>
