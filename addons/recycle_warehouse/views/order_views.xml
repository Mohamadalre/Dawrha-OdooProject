<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!--  Manager / Admin — full orders list                          -->
    <!-- ============================================================ -->
    <record id="view_recycle_order_list" model="ir.ui.view">
        <field name="name">recycle.order.list</field>
        <field name="model">recycle.order</field>
        <field name="arch" type="xml">
            <list decoration-info="state in ('processing', 'ready')"
                  decoration-success="state == 'completed'"
                  decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="customer_name" string="Factory"/>
                <field name="owner_name" optional="show"/>
                <field name="warehouse_id"/>
                <field name="output_user_id" string="Processed By" optional="show"/>
                <field name="source" optional="hide"/>
                <field name="total_weight" string="Weight (kg)" optional="show"/>
                <field name="amount_total" sum="Total"/>
                <field name="delivery_cost" string="Delivery Cost" sum="Total" optional="show"/>
                <field name="invoice_number" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'completed'"
                       decoration-warning="state == 'ready'"
                       decoration-info="state == 'processing'"
                       decoration-muted="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!--  Manager / Admin — full order form                           -->
    <!-- ============================================================ -->
    <record id="view_recycle_order_form" model="ir.ui.view">
        <field name="name">recycle.order.form</field>
        <field name="model">recycle.order</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start_processing" string="▶ Start Processing"
                            type="object" class="btn-primary oe_highlight"
                            invisible="state != 'pending'"
                            groups="recycle_warehouse.group_recycle_manager,recycle_warehouse.group_recycle_admin"/>
                    <button name="action_print_invoice" string="🖨 Print Invoice"
                            type="object"
                            invisible="state not in ('ready', 'completed')"/>
                    <button name="action_cancel" string="Cancel"
                            type="object" class="btn-secondary"
                            invisible="state in ('completed', 'cancelled')"
                            groups="recycle_warehouse.group_recycle_manager,recycle_warehouse.group_recycle_admin"/>
                    <!-- The manager's ONE step in an order: confirming the
                         prepared goods actually left the warehouse. Everything
                         before this belongs to the output employee. -->
                    <button name="action_handover_to_carrier" type="object"
                            string="&#x1F69A; Handed to Carrier"
                            class="btn-primary"
                            invisible="state != 'completed' or handover_state == 'handed_over'"
                            groups="recycle_warehouse.group_recycle_manager,recycle_warehouse.group_recycle_admin"/>
                    <button name="action_handover_to_buyer" type="object"
                            string="&#x1F91D; Collected by Buyer"
                            class="btn-primary"
                            invisible="state != 'completed' or handover_state == 'handed_over'"
                            groups="recycle_warehouse.group_recycle_manager,recycle_warehouse.group_recycle_admin"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="pending,processing,ready,completed"/>
                    <field name="handover_state" widget="statusbar"
                           invisible="state != 'completed'"/>
                </header>
                <div class="alert alert-info mb-0" invisible="state not in ('processing', 'ready')" role="status">
                    <i class="fa fa-info-circle me-2"/>
                    Storage-zone allocation, stock deduction and the output-zone
                    "Finish" step are done from the Output employee's dashboard —
                    this ensures stock is taken from the exact zones chosen and
                    logged with a timestamp.
                </div>
                <sheet>
                    <!-- Status banners -->
                    <div class="alert alert-info mb-3"
                         invisible="state != 'pending'" role="status">
                        <i class="fa fa-clock-o me-2" title="Pending"/>
                        This order is <strong>pending</strong> — waiting to be assigned to an output employee.
                    </div>
                    <div class="alert alert-warning mb-3"
                         invisible="state != 'processing'" role="status">
                        <i class="fa fa-spinner me-2" title="Loading"/>
                        Order is <strong>being processed</strong>.
                        <span invisible="not output_user_id">
                            Assigned to: <field name="output_user_id" readonly="1" nolabel="1" class="d-inline fw-bold"/>
                        </span>
                    </div>
                    <div class="alert alert-primary mb-3"
                         invisible="state != 'ready'" role="status">
                        <i class="fa fa-check-circle me-2" title="Success"/>
                        Stock deducted, invoice
                        <strong><field name="invoice_number" readonly="1" nolabel="1" class="d-inline fw-bold"/></strong>
                        generated — waiting for the output employee to choose
                        an output zone and finish.
                    </div>
                    <div class="alert alert-success mb-3"
                         invisible="state != 'completed'" role="status">
                        <i class="fa fa-check-circle me-2" title="Success"/>
                        Order <strong>completed</strong>.
                        Invoice <strong><field name="invoice_number" readonly="1" nolabel="1" class="d-inline fw-bold"/></strong>
                        generated on <field name="invoice_date" readonly="1" nolabel="1" class="d-inline"/>.
                    </div>
                    <div class="alert alert-danger mb-3"
                         invisible="state != 'cancelled'" role="status">
                        <i class="fa fa-times-circle me-2" title="Error"/> This order was <strong>cancelled</strong>.
                    </div>

                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Factory Information">
                            <field name="customer_name" string="Factory Name"
                                   readonly="state != 'pending'"/>
                            <field name="owner_name"
                                   readonly="state != 'pending'"/>
                            <field name="customer_email"
                                   readonly="state != 'pending'"/>
                            <field name="warehouse_id" readonly="state != 'pending'"
                                   options="{'no_create': True}"/>
                            <field name="backend_factory_id" readonly="state != 'pending'"/>
                        </group>
                        <group string="Processing Details">
                            <field name="source" readonly="1"/>
                            <field name="output_user_id" readonly="1"/>
                            <field name="invoice_number" readonly="1"/>
                            <field name="invoice_date" readonly="1"/>
                            <field name="stock_deducted_at" readonly="1"/>
                            <field name="output_zone_id" readonly="1"/>
                            <field name="finished_at" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Order Lines">
                            <!-- Stock warning banner — shown when any line exceeds stock -->
                            <div class="alert alert-danger d-flex align-items-center mb-3"
                                 invisible="state not in ('pending', 'processing')" role="status">
                                <i class="fa fa-exclamation-triangle fa-lg me-3" title="Warning"/>
                                <div>
                                    <strong>Stock Availability Check:</strong>
                                    Lines highlighted in red have a requested quantity that exceeds
                                    current warehouse stock. Adjust quantities or replenish stock before completing the order.
                                </div>
                            </div>
                            <field name="line_ids" readonly="state not in ('pending', 'processing')">
                                <list editable="bottom"
                                      decoration-danger="quantity > stock_qty and stock_qty >= 0">
                                    <field name="product_id" options="{'no_create': True}"/>
                                    <field name="condition"/>
                                    <field name="quantity"/>
                                    <field name="price_unit"/>
                                    <field name="stock_qty" string="In Stock (condition)" readonly="1"
                                           decoration-danger="quantity > stock_qty"
                                           decoration-success="quantity &lt;= stock_qty and stock_qty > 0"/>
                                    <field name="subtotal" sum="Total"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="amount_total" widget="monetary"
                                       options="{'currency_field': False}"/>
                                <field name="total_weight" string="Total Weight (kg)"
                                       readonly="1"/>
                                <!-- Shown only when the order actually has a
                                     delivery trip with a cost. -->
                                <field name="has_delivery_cost" invisible="1"/>
                                <field name="delivery_currency" invisible="1"/>
                                <field name="delivery_cost" readonly="1"
                                       string="Delivery Cost"
                                       invisible="not has_delivery_cost"/>
                            </group>
                        </page>
                        <page string="Zone Movements" invisible="not zone_movement_ids">
                            <field name="zone_movement_ids" readonly="1">
                                <list>
                                    <field name="product_id"/>
                                    <field name="condition"/>
                                    <field name="zone_id"/>
                                    <field name="quantity"/>
                                    <field name="moved_by"/>
                                    <field name="moved_at"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!--  Output Employee — available orders list (pending only)       -->
    <!-- ============================================================ -->
    <record id="view_recycle_available_orders_list" model="ir.ui.view">
        <field name="name">recycle.order.available.list</field>
        <field name="model">recycle.order</field>
        <field name="priority">25</field>
        <field name="arch" type="xml">
            <list string="Available Orders"
                  decoration-info="state == 'processing'"
                  decoration-success="state == 'completed'"
                  decoration-muted="state == 'cancelled'">
                <field name="name" string="Order Ref"/>
                <field name="customer_name" string="Factory Name"/>
                <field name="owner_name" string="Factory Owner"/>
                <field name="warehouse_id" string="Warehouse"/>
                <field name="amount_total" string="Total Amount" sum="Total"/>
                <field name="total_weight" string="Weight (kg)"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'pending'"
                       decoration-success="state == 'completed'"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!--  Output Employee — my orders list                            -->
    <!-- ============================================================ -->
    <record id="view_recycle_my_orders_list" model="ir.ui.view">
        <field name="name">recycle.order.my.list</field>
        <field name="model">recycle.order</field>
        <field name="priority">26</field>
        <field name="arch" type="xml">
            <list string="My Orders"
                  decoration-info="state == 'processing'"
                  decoration-warning="state == 'ready'"
                  decoration-success="state == 'completed'"
                  decoration-muted="state == 'cancelled'">
                <field name="name" string="Order Ref"/>
                <field name="customer_name" string="Factory Name"/>
                <field name="owner_name" string="Factory Owner"/>
                <field name="warehouse_id" string="Warehouse"/>
                <field name="amount_total" string="Total Amount" sum="Total"/>
                <field name="total_weight" string="Weight (kg)"/>
                <field name="invoice_number" string="Invoice"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'processing'"
                       decoration-warning="state == 'ready'"
                       decoration-success="state == 'completed'"
                       decoration-muted="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!--  Output Employee — dedicated order form (read-only lines)    -->
    <!-- ============================================================ -->
    <record id="view_recycle_order_output_form" model="ir.ui.view">
        <field name="name">recycle.order.output.form</field>
        <field name="model">recycle.order</field>
        <field name="priority">25</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start_processing"
                            string="▶ Start Processing"
                            type="object" class="btn-primary oe_highlight"
                            invisible="state != 'pending'"/>
                    <button name="action_complete"
                            string="✓ Complete Order"
                            type="object" class="btn-primary oe_highlight"
                            invisible="state not in ('processing', 'ready')"/>
                    <button name="action_release_order"
                            string="⟲ Release Order"
                            type="object" class="btn-secondary"
                            invisible="state != 'processing'"/>
                    <button name="action_print_invoice"
                            string="🖨 Print Invoice (PDF)"
                            type="object" class="btn-success"
                            invisible="state != 'completed'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="pending,processing,completed"/>
                </header>
                <sheet>
                    <!-- Status banners -->
                    <div class="alert alert-info d-flex align-items-center mb-3"
                         invisible="state != 'pending'" role="status">
                        <i class="fa fa-info-circle fa-lg me-3" title="Information"/>
                        <div>
                            <strong>Order is available.</strong><br/>
                            Click <em>"Start Processing"</em> to reserve this order and begin preparation.
                        </div>
                    </div>
                    <div class="alert alert-warning d-flex align-items-center mb-3"
                         invisible="state != 'processing'" role="status">
                        <i class="fa fa-cog fa-spin fa-lg me-3" title="Processing"/>
                        <div>
                            <strong>Processing in progress.</strong><br/>
                            Move items from Storage to the Output zone, then click <em>"Complete Order"</em> to deduct stock and generate the invoice.
                        </div>
                    </div>
                    <div class="alert alert-success d-flex align-items-center mb-3"
                         invisible="state != 'completed'" role="status">
                        <i class="fa fa-check-circle fa-lg me-3" title="Success"/>
                        <div>
                            <strong>Order completed!</strong>
                            Invoice <strong><field name="invoice_number" readonly="1" nolabel="1" class="d-inline fw-bold"/></strong>
                            generated on <field name="invoice_date" readonly="1" nolabel="1" class="d-inline"/>.
                            Click <em>"Print Invoice (PDF)"</em> to export.
                        </div>
                    </div>
                    <div class="alert alert-danger d-flex align-items-center mb-3"
                         invisible="state != 'cancelled'" role="status">
                        <i class="fa fa-times-circle fa-lg me-3" title="Error"/>
                        <div><strong>This order was cancelled.</strong></div>
                    </div>

                    <div class="oe_title">
                        <label class="o_form_label" for="name">Order Reference</label>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>

                    <group>
                        <group string="Factory Information">
                            <field name="customer_name" string="Factory Name" readonly="1"/>
                            <field name="owner_name" string="Factory Owner" readonly="1"/>
                            <field name="customer_email" string="Contact Email" readonly="1"
                                   invisible="not customer_email"/>
                            <field name="warehouse_id" string="Warehouse" readonly="1"/>
                        </group>
                        <group string="Processing Details">
                            <field name="output_user_id" string="Processed By" readonly="1"/>
                            <field name="invoice_number" readonly="1"
                                   invisible="not invoice_number"/>
                            <field name="invoice_date" readonly="1"
                                   invisible="not invoice_date"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Order Lines">
                            <field name="line_ids" readonly="1">
                                <list>
                                    <field name="product_id" string="Product"/>
                                    <field name="condition" string="Condition"/>
                                    <field name="quantity" string="Quantity"/>
                                    <field name="price_unit" string="Unit Price"/>
                                    <field name="subtotal" string="Subtotal" sum="Total"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="amount_total" string="Total Amount"
                                       widget="monetary"
                                       options="{'currency_field': False}"/>
                                <field name="total_weight" string="Total Weight (kg)"
                                       readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!--  Shared search view                                           -->
    <!-- ============================================================ -->
    <record id="view_recycle_order_search" model="ir.ui.view">
        <field name="name">recycle.order.search</field>
        <field name="model">recycle.order</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="customer_name" string="Factory Name"/>
                <field name="owner_name"/>
                <field name="warehouse_id" string="Warehouse"/>
                <field name="output_zone_id" string="Output Zone"/>
                <filter string="Pending" name="filter_pending"
                        domain="[('state', '=', 'pending')]"/>
                <filter string="Processing" name="filter_processing"
                        domain="[('state', '=', 'processing')]"/>
                <filter string="Ready" name="filter_ready"
                        domain="[('state', '=', 'ready')]"/>
                <filter string="Completed" name="filter_completed"
                        domain="[('state', '=', 'completed')]"/>
                <filter string="Cancelled" name="filter_cancelled"
                        domain="[('state', '=', 'cancelled')]"/>
                <filter string="Archived" name="filter_archived"
                        domain="[('recycle_archived', '=', True)]"/>
                <separator/>
                <filter string="Zone Type: Output" name="zone_output"
                        domain="[('output_zone_id.zone_type','=','output')]"/>
                <separator/>
                <filter string="Warehouse" name="group_warehouse"
                        context="{'group_by': 'warehouse_id'}"/>
                <filter string="Status" name="group_state"
                        context="{'group_by': 'state'}"/>
                <filter string="Output Zone" name="group_zone"
                        context="{'group_by': 'output_zone_id'}"/>
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!--  Admin read-only Order list (no create / no delete)          -->
    <!-- ============================================================ -->
    <record id="view_recycle_order_list_admin_ro" model="ir.ui.view">
        <field name="name">recycle.order.list.admin.ro</field>
        <field name="model">recycle.order</field>
        <field name="arch" type="xml">
            <list create="0" delete="0"
                  decoration-info="state in ('processing', 'ready')"
                  decoration-success="state == 'completed'"
                  decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="customer_name" string="Factory"/>
                <field name="owner_name" optional="show"/>
                <field name="warehouse_id"/>
                <field name="output_user_id" string="Processed By" optional="show"/>
                <field name="source" optional="hide"/>
                <field name="total_weight" string="Weight (kg)" optional="show"/>
                <field name="amount_total" sum="Total"/>
                <field name="delivery_cost" string="Delivery Cost" sum="Total" optional="show"/>
                <field name="invoice_number" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'completed'"
                       decoration-warning="state == 'ready'"
                       decoration-info="state == 'processing'"
                       decoration-muted="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- Admin read-only Order form (view only — no action buttons) -->
    <record id="view_recycle_order_form_admin_ro" model="ir.ui.view">
        <field name="name">recycle.order.form.admin.ro</field>
        <field name="model">recycle.order</field>
        <field name="arch" type="xml">
            <form edit="0" create="0">
                <header>
                    <button name="action_print_invoice" string="&#x1F5A8; Print Invoice"
                            type="object"
                            invisible="state != 'completed'"
                            groups="recycle_warehouse.group_recycle_admin"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="pending,processing,ready,completed"/>
                </header>
                <sheet>
                    <!-- Status banners -->
                    <div class="alert alert-info mb-3" invisible="state != 'pending'" role="status">
                        <i class="fa fa-clock-o me-2" title="Pending"/>
                        This order is <strong>pending</strong>.
                    </div>
                    <div class="alert alert-warning mb-3" invisible="state != 'processing'" role="status">
                        <i class="fa fa-spinner me-2" title="Loading"/>
                        Order is <strong>being processed</strong>.
                        <span invisible="not output_user_id">
                            Assigned to: <field name="output_user_id" readonly="1" nolabel="1" class="d-inline fw-bold"/>
                        </span>
                    </div>
                    <div class="alert alert-primary mb-3" invisible="state != 'ready'" role="status">
                        <i class="fa fa-check-circle me-2" title="Success"/>
                        Order is <strong>ready</strong>.
                    </div>
                    <div class="alert alert-success mb-3" invisible="state != 'completed'" role="status">
                        <i class="fa fa-check-circle me-2" title="Success"/>
                        Order <strong>completed</strong>.
                        Invoice <strong><field name="invoice_number" readonly="1" nolabel="1" class="d-inline fw-bold"/></strong>
                        generated on <field name="invoice_date" readonly="1" nolabel="1" class="d-inline"/>.
                    </div>
                    <div class="alert alert-danger mb-3" invisible="state != 'cancelled'" role="status">
                        <i class="fa fa-times-circle me-2" title="Error"/> This order was <strong>cancelled</strong>.
                    </div>

                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Factory Information">
                            <field name="customer_name" readonly="1" string="Factory Name"/>
                            <field name="owner_name" readonly="1"/>
                            <field name="customer_email" readonly="1"/>
                        </group>
                        <group string="Order Details">
                            <field name="warehouse_id" readonly="1"/>
                            <field name="source" readonly="1"/>
                            <field name="output_user_id" readonly="1"/>
                            <field name="invoice_number" readonly="1" invisible="not invoice_number"/>
                            <field name="invoice_date" readonly="1" invisible="not invoice_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Order Lines">
                            <field name="line_ids" readonly="1">
                                <list>
                                    <field name="product_id"/>
                                    <field name="condition"/>
                                    <field name="quantity"/>
                                    <field name="price_unit"/>
                                    <field name="subtotal"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <group class="oe_subtotal_footer oe_right">
                        <field name="total_weight" readonly="1" string="Total Weight (kg)"/>
                        <field name="amount_total" readonly="1" class="oe_subtotal_footer_separator"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Admin read-only action -->
    <record id="action_recycle_order_admin_ro" model="ir.actions.act_window">
        <field name="name">Orders</field>
        <field name="res_model">recycle.order</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_recycle_order_list_admin_ro')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_recycle_order_form_admin_ro')})]"/>
    </record>

    <!-- ============================================================ -->
    <!--  Actions                                                      -->
    <!-- ============================================================ -->

    <!-- Manager / Admin: all orders -->
    <record id="action_recycle_order" model="ir.actions.act_window">
        <field name="name">Orders</field>
        <field name="res_model">recycle.order</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_recycle_order_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_recycle_order_form')})]"/>
    </record>

    <!-- Output Employee: available (pending) orders to process -->
    <record id="action_available_orders" model="ir.actions.act_window">
        <field name="name">Available Orders</field>
        <field name="res_model">recycle.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'pending')]</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_recycle_available_orders_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_recycle_order_output_form')})]"/>
    </record>

    <!-- Output Employee: orders they are/were processing -->
    <record id="action_my_processed_orders" model="ir.actions.act_window">
        <field name="name">My Orders</field>
        <field name="res_model">recycle.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('output_user_id', '=', uid)]</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_recycle_my_orders_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_recycle_order_output_form')})]"/>
    </record>

    <!-- ============================================================ -->
    <!--  Output Employee — My Invoices list (completed + invoiced)   -->
    <!-- ============================================================ -->
    <record id="view_recycle_invoice_list" model="ir.ui.view">
        <field name="name">recycle.order.invoice.list</field>
        <field name="model">recycle.order</field>
        <field name="priority">30</field>
        <field name="arch" type="xml">
            <list string="My Invoices" create="false" delete="false"
                  decoration-success="state == 'completed'">
                <field name="invoice_number" string="Invoice #"/>
                <field name="invoice_date" string="Date"/>
                <field name="name" string="Order Ref"/>
                <field name="customer_name" string="Factory"/>
                <field name="owner_name" string="Owner"/>
                <field name="warehouse_id" string="Warehouse"/>
                <field name="total_weight" string="Weight (kg)"/>
                <field name="amount_total" string="Total Amount" sum="Grand Total"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'completed'"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!--  Output Employee — Beautiful read-only Invoice detail view   -->
    <!-- ============================================================ -->
    <record id="view_recycle_invoice_form" model="ir.ui.view">
        <field name="name">recycle.order.invoice.form</field>
        <field name="model">recycle.order</field>
        <field name="priority">30</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <header>
                    <button name="action_print_invoice"
                            string="🖨 Export Invoice as PDF"
                            type="object"
                            class="btn-primary oe_highlight"/>
                    <field name="state" widget="badge"
                           decoration-success="state == 'completed'"
                           readonly="1"/>
                </header>
                <sheet>
                    <!-- Invoice banner header -->
                    <div style="background: linear-gradient(135deg, #3b0764 0%, #7c3aed 100%); border-radius: 14px; padding: 28px 32px; margin-bottom: 24px; color: #fff;">
                        <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px;">
                            <div>
                                <div style="font-size:0.85rem; color:#ddd6fe; text-transform:uppercase; letter-spacing:1px; margin-bottom:4px;">
                                    ♻ Recycle Warehouse — Invoice
                                </div>
                                <div style="font-size:1.9rem; font-weight:800; color:#fff; line-height:1.1;">
                                    <field name="invoice_number" readonly="1" nolabel="1"/>
                                </div>
                            </div>
                            <div style="text-align:right;">
                                <div style="font-size:0.82rem; color:#ddd6fe; margin-bottom:4px;">Invoice Date</div>
                                <div style="font-size:1.15rem; font-weight:700; color:#fff;">
                                    <field name="invoice_date" readonly="1" nolabel="1"/>
                                </div>
                                <div style="margin-top:8px; font-size:0.82rem; color:#ddd6fe;">Order Reference</div>
                                <div style="font-size:0.95rem; color:#f3e8ff; font-weight:600;">
                                    <field name="name" readonly="1" nolabel="1"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Info cards row -->
                    <div class="row mb-4">
                        <div class="col-md-6 mb-3">
                            <div style="border: 1.5px solid #e9d5ff; border-radius: 12px; padding: 20px 22px; background: #faf5ff; height: 100%;">
                                <div style="font-size:0.78rem; font-weight:700; color:#7c3aed; text-transform:uppercase; letter-spacing:0.8px; margin-bottom:12px;">
                                    🏭 Factory Information
                                </div>
                                <div style="font-size:1.05rem; font-weight:700; color:#1f2937; margin-bottom:4px;">
                                    <field name="customer_name" readonly="1" nolabel="1"/>
                                </div>
                                <div style="color:#6b7280; font-size:0.9rem; margin-bottom:2px;" invisible="not owner_name">
                                    Owner: <field name="owner_name" readonly="1" nolabel="1"/>
                                </div>
                                <div style="color:#9ca3af; font-size:0.85rem;" invisible="not customer_email">
                                    <field name="customer_email" readonly="1" nolabel="1"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <div style="border: 1.5px solid #bbf7d0; border-radius: 12px; padding: 20px 22px; background: #f0fdf4; height: 100%;">
                                <div style="font-size:0.78rem; font-weight:700; color:#059669; text-transform:uppercase; letter-spacing:0.8px; margin-bottom:12px;">
                                    🏢 Processing Details
                                </div>
                                <div style="font-size:0.92rem; color:#374151; margin-bottom:5px;">
                                    <strong>Warehouse:</strong>
                                    <field name="warehouse_id" readonly="1" nolabel="1"/>
                                </div>
                                <div style="font-size:0.92rem; color:#374151; margin-bottom:5px;">
                                    <strong>Processed By:</strong>
                                    <field name="output_user_id" readonly="1" nolabel="1"/>
                                </div>
                                <div style="font-size:0.92rem; color:#374151;">
                                    <strong>Source:</strong>
                                    <field name="source" readonly="1" nolabel="1"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Products table -->
                    <div style="border: 1.5px solid #e5e7eb; border-radius: 12px; overflow: hidden; margin-bottom: 20px;">
                        <div style="background: #f9fafb; border-bottom: 1px solid #e5e7eb; padding: 12px 20px; font-size:0.85rem; font-weight:700; color:#374151; text-transform:uppercase; letter-spacing:0.8px;">
                            📦 Order Lines
                        </div>
                        <div>
                            <field name="line_ids" readonly="1">
                                <list create="false" delete="false">
                                    <field name="product_id" string="Product"/>
                                    <field name="condition" string="Condition"/>
                                    <field name="quantity" string="Qty"/>
                                    <field name="price_unit" string="Unit Price"/>
                                    <field name="subtotal" string="Subtotal" sum="Total"/>
                                </list>
                            </field>
                        </div>
                    </div>

                    <!-- Totals -->
                    <div class="row justify-content-end">
                        <div class="col-md-5">
                            <div style="border: 2px solid #7c3aed; border-radius: 12px; overflow: hidden;">
                                <div style="background: #faf5ff; padding: 12px 20px; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #e9d5ff;">
                                    <span style="color:#6b7280; font-size:0.9rem;">Total Weight</span>
                                    <span style="font-weight:600; color:#374151; font-size:0.9rem;">
                                        <field name="total_weight" readonly="1" nolabel="1"/> kg
                                    </span>
                                </div>
                                <div style="background: linear-gradient(135deg, #3b0764 0%, #7c3aed 100%); padding: 16px 20px; display: flex; justify-content: space-between; align-items: center;">
                                    <span style="color:#fff; font-weight:700; font-size:1rem;">Grand Total</span>
                                    <span style="color:#fff; font-weight:800; font-size:1.3rem;">
                                        <field name="amount_total" readonly="1" nolabel="1"/>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>

                </sheet>
            </form>
        </field>
    </record>

    <!-- Output Employee: My Invoices (completed orders processed by me) -->
    <record id="action_my_invoices" model="ir.actions.act_window">
        <field name="name">My Invoices</field>
        <field name="res_model">recycle.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('output_user_id', '=', uid), ('state', '=', 'completed'), ('invoice_number', '!=', False)]</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_recycle_invoice_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_recycle_invoice_form')})]"/>
    </record>

    <!-- Archive: archived orders, same filters/search identity -->
    <record id="action_recycle_order_archive" model="ir.actions.act_window">
        <field name="name">Orders Archive</field>
        <field name="res_model">recycle.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[("recycle_archived","=",True)]</field>
        <field name="search_view_id" ref="view_recycle_order_search"/>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">No archived orders</p></field>
    </record>
</odoo>
