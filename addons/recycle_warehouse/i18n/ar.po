# Translation of Recycle Warehouse Management into Arabic.
#
# WHY THIS FILE EXISTS
#
# Every user-facing message in the Python code is already wrapped in `_()` —
# 293 of them, correctly, from the first commit. But `_()` only translates
# against a CATALOGUE, and this module had no `i18n/` directory at all. So the
# wrapping did nothing: an Arabic-speaking warehouse employee hit "Only accepted
# drivers can be blocked." in English, and no amount of `_()` was going to
# change that.
#
# `recycle_warehouse.pot` beside this file is the exported template — the
# authoritative msgid list, regenerated from the module rather than typed by
# hand, so a msgid here can never drift from the string the code actually
# raises.
#
# HOW TO CONTINUE
#
#   1. Regenerate the template after adding messages (Odoo shell):
#        from odoo.tools.translate import trans_export
#        import io; buf = io.BytesIO()
#        trans_export(None, ['recycle_warehouse'], buf, 'po', env)
#   2. Merge new msgids into this file and fill their msgstr.
#   3. Upgrade the module — Odoo loads i18n/<lang>.po on install/upgrade.
#
msgid ""
msgstr ""
"Project-Id-Version: Odoo Server 19.0\n"
"Report-Msgid-Bugs-To: \n"
"Last-Translator: \n"
"Language-Team: Arabic\n"
"Language: ar\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=6; plural=(n==0 ? 0 : n==1 ? 1 : n==2 ? 2 : n%100>=3 "
"&& n%100<=10 ? 3 : n%100>=11 ? 4 : 5);\n"
