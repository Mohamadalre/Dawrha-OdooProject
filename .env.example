# ── Dawrha Odoo — environment configuration ──────────────────────────────────
# Copy to `.env` (which docker compose auto-loads) and fill in your values.
#   cp .env.example .env
#
# These drive the DYNAMIC backend sync: the addon's post_init_hook reads them on
# install/upgrade and writes the recycle.backend_* system parameters, so the same
# image syncs correctly in any environment without editing the database by hand.

# Where the NestJS backend lives, as seen FROM the Odoo container.
#   - Local dev (backend on the host):   http://host.docker.internal:3000
#   - Production:                         https://api.dawrha.com
RECYCLE_BACKEND_BASE_URL=http://host.docker.internal:3000

# Shared secret for the signed webhooks. MUST equal the backend's
# ODOO_WEBHOOK_SECRET exactly (≥ 32 chars), or the backend rejects the pings.
RECYCLE_BACKEND_WEBHOOK_SECRET=

# Optional extra API key header for the outbound calls (leave empty if unused).
RECYCLE_BACKEND_API_KEY=
